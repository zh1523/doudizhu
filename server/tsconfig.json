{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@engine/*": ["../client/src/engine/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts"]
}
